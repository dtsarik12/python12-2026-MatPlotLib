import matplotlib.pyplot as plt
import matplotlib.patches as patches

fig, ax = plt.subplots(figsize=(7, 7))

rect = patches.Rectangle((0, 0), 1, 1, facecolor='gray')
circle = patches.Circle((0, 0), 0.5, facecolor='gray')

rect.set_xy((2, 1))          # нижній лівий кут
rect.set_width(4)            # ширина
rect.set_height(2)           # висота
rect.set_facecolor('coral')  # колір заливки
rect.set_edgecolor('red')    # колір контуру
rect.set_linewidth(2)

circle.set_center((4, 6))       # положення центру
circle.set_radius(1.8)          # радіус
circle.set_facecolor('gold')    # колір заливки
circle.set_alpha(0.7)           # налаштування прозорості

ax.add_patch(rect)
ax.add_patch(circle)

ax.set_xlim(0, 8)
ax.set_ylim(0, 10)
ax.set_aspect('equal')

ax.set_title("фігури, модифіковані через методи set_*", fontsize=14)
ax.grid(True, alpha=0.3)

plt.show()
