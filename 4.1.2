import numpy as np
import matplotlib.pyplot as plt

# для відображення кирилиці на графіках
plt.rcParams['font.family'] = 'DejaVu Sans'

x2 = np.linspace(0, 2 * np.pi, 40)  # 40 точок, щоб маркери не зливалися
y2 = np.sin(x2)

plt.figure(figsize=(8, 5))
plt.plot(x2, y2, linestyle='--', marker='o', color='royalblue', label='y = sin(x)')

plt.xlabel('x (радіани)')
plt.ylabel('y')
plt.title('Графік функції y = sin(x)')
plt.grid(True, alpha=0.3)
plt.legend()

plt.show()
