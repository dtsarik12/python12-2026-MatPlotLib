import numpy as np
import matplotlib.pyplot as plt

# для відображення кирилиці на графіках
plt.rcParams['font.family'] = 'DejaVu Sans'

x3 = np.linspace(0, 2 * np.pi, 100)
y3 = np.cos(x3)

plt.figure(figsize=(8, 5))
plt.plot(x3, y3, linestyle='-.', alpha=0.4, color='forestgreen', linewidth=3, label='y = cos(x)')

plt.xlabel('x (радіани)')
plt.ylabel('y')
plt.title('Графік функції y = cos(x) із налаштуванням прозорості')
plt.grid(True, alpha=0.3)
plt.legend()

plt.show()
